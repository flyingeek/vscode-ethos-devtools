.vscode/**
.vscode-test/**
.github/**
out/**/*.js.map
out/**/*.test.js
out/**/*.test.js.map
tests/**
src/**
docs/**
csv-examples/**
.gitignore
tsconfig.json

# Bundle node-hid (native addon) and its transitive runtime deps;
# exclude everything else in node_modules.
#
# CAVEAT: `!node_modules/node-hid/` unignores the whole directory (and
# `!node_modules/node-hid/build/`, `.../build/Release/` do the same for those
# subdirs). Per gitignore semantics, unignoring a directory re-includes
# everything inside it by default — so the specific file patterns below
# (nodehid.js, package.json, etc.) are NOT a real allowlist, they're inert.
# The actual trimming (removing bin/, hidapi/, prebuilds/, src/, binding.gyp,
# non-.node build files) is done by the "Trim node-hid package contents" step
# in .github/workflows/release.yml via `rm -rf`, which runs before `vsce
# package`. If node-hid is upgraded and starts shipping new files, update
# that CI step, not this file — this file alone won't stop them from being
# bundled.
node_modules/**
!node_modules/node-hid/
!node_modules/node-hid/package.json
!node_modules/node-hid/nodehid.js
!node_modules/node-hid/nodehid.d.ts
!node_modules/node-hid/binding-options.js
!node_modules/node-hid/LICENSE-bsd.txt
!node_modules/node-hid/build/
!node_modules/node-hid/build/Release/
!node_modules/node-hid/build/Release/*.node
!node_modules/pkg-prebuilds/**

# Bundle fflate (pure JS, zero-dependency runtime dep used by
# installTheme/installAudioPack to unzip downloaded archives). We use it via
# a dynamic import(), which Node resolves through the "import" export
# condition (./esm/index.mjs), not the CJS build — only that file plus
# package.json are needed at runtime.
!node_modules/fflate/package.json
!node_modules/fflate/esm/index.mjs
